<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 counterpart of data_extraction_rules.xml. android:allowBackup is already false,
    so nothing here should ever run, but the institutional session must be excluded on every path
    that could copy app data off the device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="institutional_session.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
