<?xml version="1.0" encoding="utf-8"?>
<!--
    android:allowBackup is already false, but device-to-device transfer on Android 12+ is governed
    separately. The institutional session (JWT access/refresh tokens) must never leave this device
    by either route, so it is excluded explicitly from both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="institutional_session.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="institutional_session.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
