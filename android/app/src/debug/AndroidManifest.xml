<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only overlay. It permits cleartext to emulator loopback addresses so the Institutional
    Workspace can be pointed at a local backend during development. Release builds keep
    android:usesCleartextTraffic="false" from the main manifest and ship no such exemption.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
