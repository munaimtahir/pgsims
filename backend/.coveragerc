[run]
source = sims
branch = True
omit =
    */migrations/*
    */_legacy/*
    */tests/*
    */tests.py
    */test_*.py
    */*_test.py
    */conftest.py
    manage.py
    sims_project/settings.py
    sims_project/wsgi.py
    sims_project/asgi.py
    */apps.py
    */__pycache__/*
    */venv/*
    */env/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod
precision = 2
skip_empty = True

[html]
directory = htmlcov
