# Copy to docker/.env.staging.local (which Git ignores), set unique random values,
# and never reuse a production database, Redis, or Django secret.
STAGING_DB_NAME=pgsims_staging
STAGING_DB_USER=pgsims_staging
STAGING_DB_PASSWORD=replace-with-a-unique-random-password
STAGING_SECRET_KEY=replace-with-a-unique-random-django-secret
STAGING_BACKEND_PORT=18014
STAGING_ALLOWED_HOSTS=staging.pgsims.alshifalab.pk,localhost,127.0.0.1,10.0.2.2

# For the local emulator-only stack keep these false. Set all three to True only
# after an HTTPS reverse proxy is in front of the service.
STAGING_USE_PROXY_HEADERS=False
STAGING_SECURE_SSL_REDIRECT=False
STAGING_SESSION_COOKIE_SECURE=False
STAGING_CSRF_COOKIE_SECURE=False
STAGING_CSRF_TRUSTED_ORIGINS=
STAGING_CORS_ALLOWED_ORIGINS=
